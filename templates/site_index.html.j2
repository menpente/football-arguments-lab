<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Football data stories</title>
<style>
  :root { --bg: #f7f7f5; --fg: #17171a; --muted: #55565c; --card: #ffffff; --accent: #2563eb; --border: #e5e5e2; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #121214; --fg: #f2f2f0; --muted: #a3a3a8; --card: #1c1c1f; --border: #2c2c30; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--fg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; line-height: 1.55;
  }
  main { max-width: 1040px; margin: 0 auto; padding: 4rem 1.5rem 6rem; }
  h1 { font-size: 1.9rem; margin-bottom: 0.5rem; }
  p.intro { color: var(--muted); margin: 0 0 2.5rem; }

  .layout { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
  @media (min-width: 820px) {
    .layout { grid-template-columns: 1.7fr 1fr; align-items: start; }
    .ask { position: sticky; top: 2rem; }
  }

  h2.section { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--muted); margin: 0 0 1rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { margin-top: 1rem; }
  a.story-card {
    display: block; background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 1.25rem 1.5rem; text-decoration: none; color: inherit;
  }
  a.story-card h3 { margin: 0 0 0.4rem; font-size: 1.1rem; color: var(--accent); }
  a.story-card p { margin: 0; color: var(--muted); font-size: 0.9rem; }
  p.empty { color: var(--muted); }

  .ask .panel {
    background: var(--card); border: 1px solid var(--border); border-radius: 12px;
    padding: 1.5rem;
  }
  .ask label { display: block; font-weight: 600; font-size: 0.9rem; margin-bottom: 0.4rem; }
  .ask textarea, .ask input[type="text"] {
    width: 100%; font: inherit; color: inherit; background: var(--bg);
    border: 1px solid var(--border); border-radius: 8px; padding: 0.6rem 0.7rem;
    margin-bottom: 1rem; resize: vertical;
  }
  .ask textarea { min-height: 5rem; }
  .ask button {
    width: 100%; font: inherit; font-weight: 600; cursor: pointer;
    background: var(--accent); color: #fff; border: 0; border-radius: 8px;
    padding: 0.65rem 1rem;
  }
  .ask button:disabled { opacity: 0.5; cursor: not-allowed; }
  .ask .hint { color: var(--muted); font-size: 0.8rem; margin: 0.9rem 0 0; }
</style>
</head>
<body>
<main>
  <h1>Football data stories</h1>
  <p class="intro">Viral football debates, settled with data — one editorial arc at a time.</p>

  <div class="layout">
    <section>
      <h2 class="section">Published</h2>
      {% if stories %}
      <ul>
        {% for story in stories %}
        <li>
          <a class="story-card" href="stories/{{ story.slug }}/">
            <h3>{{ story.title }}</h3>
            <p>{{ story.dek }}</p>
          </a>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="empty">No stories published yet.</p>
      {% endif %}
    </section>

    <aside class="ask">
      <h2 class="section">Ask your own</h2>
      <div class="panel">
        <form id="ask-form">
          <label for="q">A football debate you want settled with data</label>
          <textarea id="q" required placeholder="e.g. Is Rodri actually irreplaceable for City?"></textarea>
          <label for="note">Anything the editor should know (optional)</label>
          <input type="text" id="note" placeholder="Where you keep seeing this take, why it matters…">
          <button type="submit" id="ask-submit">Open a pre-filled issue &rarr;</button>
        </form>
        <p class="hint">
          This opens a pre-filled issue on GitHub (you'll need an account).
          Approved questions run through the same editorial pipeline as the
          stories above.
        </p>
      </div>
    </aside>
  </div>
</main>

<script>
  (function () {
    var repo = "menpente/football-arguments-lab";
    var form = document.getElementById("ask-form");
    var q = document.getElementById("q");
    var note = document.getElementById("note");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var question = q.value.trim();
      if (!question) { q.focus(); return; }
      var url = "https://github.com/" + repo + "/issues/new?template=submission.yml"
        + "&question=" + encodeURIComponent(question)
        + "&note=" + encodeURIComponent(note.value.trim());
      window.open(url, "_blank", "noopener");
    });
  })();
</script>
</body>
</html>
